<!doctype html>
<html><meta charset="utf-8"><title>{{ episode.title }}</title>
<style>body{margin:0;background:#14242b;color:white;font:32px system-ui}figure{margin:0;height:100vh;display:flex;flex-direction:column;align-items:center}img{min-height:0;flex:1;max-width:100%;object-fit:contain}figcaption{padding:12px}</style>
<figure><img src="{{ src }}" alt="">{% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}</figure>
</html>
